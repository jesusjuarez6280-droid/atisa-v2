# --- Python ---
__pycache__/
*.py[cod]

# --- SQLite (WAL crea estos archivos junto a la BD) ---
*.db-wal
*.db-shm

# --- Tailwind: el binario es pesado (40MB), no se versiona ---
tailwindcss.exe

# --- Sistema ---
.DS_Store
Thumbs.db

# Claude Code (interno, no es del proyecto)
.claude/

# Archivos subidos en runtime (responsivas firmadas, etc.)
static/contratos/
static/documentos_legales/
static/img_recetas/

# --- Seguridad: llave de sesión generada en el primer arranque (NUNCA se versiona) ---
.secret_key

# --- Respaldos automáticos diarios de la base ---
respaldos/
logs/
